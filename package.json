{
  "name": "toodooh-flasher",
  "version": "2.0.0",
  "description": "Flash and provision Toodooh PAX Counters (ESP32) over USB — no toolchain required",
  "author": "Toodooh",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package": "electron-vite build && electron-builder --win portable",
    "test": "node scripts/test-provision-openwifi.mjs"
  },
  "dependencies": {
    "@serialport/parser-readline": "^12.0.0",
    "esptool-js": "^0.6.0",
    "serialport": "^12.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0",
    "electron-vite": "^2.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sass": "^1.71.0",
    "vite": "^5.0.0"
  },
  "build": {
    "appId": "com.toodooh.flasher",
    "productName": "Toodooh Flasher",
    "icon": "resources/icon.ico",
    "win": {
      "target": "portable",
      "icon": "resources/icon.ico"
    },
    "portable": {
      "artifactName": "ToodoohFlasher.exe"
    },
    "asar": true,
    "asarUnpack": [
      "**/node_modules/serialport/**",
      "**/node_modules/@serialport/**"
    ],
    "extraResources": [
      {
        "from": "resources/firmware-bin",
        "to": "firmware-bin",
        "filter": ["**/*"]
      },
      {
        "from": "resources/drivers",
        "to": "drivers",
        "filter": ["**/*"]
      }
    ],
    "files": [
      "out/**/*",
      "!**/build/Release/**",
      "!**/build/Debug/**"
    ]
  }
}
