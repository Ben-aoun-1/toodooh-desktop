{
  "name": "Toodooh PAX Counter firmware",
  "base": "Toodooh universal v1.0.0",
  "version": "1.0.0",
  "flashBaud": 460800,
  "targets": {
    "esp32": {
      "files": [
        {
          "address": "0x1000",
          "path": "esp32/bootloader.bin"
        },
        {
          "address": "0x8000",
          "path": "esp32/partitions.bin"
        },
        {
          "address": "0x10000",
          "path": "esp32/firmware.bin"
        }
      ]
    },
    "esp32s3": {
      "files": [
        {
          "address": "0x0",
          "path": "esp32s3/bootloader.bin"
        },
        {
          "address": "0x8000",
          "path": "esp32s3/partitions.bin"
        },
        {
          "address": "0x10000",
          "path": "esp32s3/firmware.bin"
        }
      ]
    },
    "esp32c3": {
      "files": [
        {
          "address": "0x0",
          "path": "esp32c3/bootloader.bin"
        },
        {
          "address": "0x8000",
          "path": "esp32c3/partitions.bin"
        },
        {
          "address": "0x10000",
          "path": "esp32c3/firmware.bin"
        }
      ]
    },
    "esp32c6": {
      "files": [
        {
          "address": "0x0",
          "path": "esp32c6/bootloader.bin"
        },
        {
          "address": "0x8000",
          "path": "esp32c6/partitions.bin"
        },
        {
          "address": "0x10000",
          "path": "esp32c6/firmware.bin"
        }
      ]
    }
  }
}
